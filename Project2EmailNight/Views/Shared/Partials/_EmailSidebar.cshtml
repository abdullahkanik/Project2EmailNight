@await Component.InvokeAsync("_EmailSidebarCounts")
@* Views/Shared/Partials/_EmailSidebar.cshtml *@
@{
    string path = Context.Request.Path.Value?.ToLower() ?? "";
    bool isActive(string urlPart) => path.Contains(urlPart);

    // ✅ ViewComponent'ten gelen gerçek sayılar
    int inboxUnread = ViewBag.InboxUnread ?? 0;   // okunmamış
    int inboxTotal = ViewBag.InboxTotal ?? 0;    // toplam (istersen kullanırız)
    int sentTotal = ViewBag.SentTotal ?? 0;

    // Şimdilik hazır olmayan bölümler (0 göster)
    int starCount = ViewBag.StarCount ?? 0;
    int trashCount = ViewBag.TrashCount ?? 0;
    int draftCount = ViewBag.DraftCount ?? 0;
    int spamCount = ViewBag.SpamCount ?? 0;

    int catEdu = ViewBag.CatEdu ?? 0;
    int catProje = ViewBag.CatProje ?? 0;
    int catIs = ViewBag.CatIs ?? 0;
    int catDiger = ViewBag.CatDiger ?? 0;
}

<style>
    .email-nav-title {
        font-size: 12px;
        font-weight: 800;
        color: #94a3b8;
        letter-spacing: .05em;
        margin: 16px 16px 8px 16px;
        text-transform: uppercase;
    }

    .email-nav-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        border-radius: 10px;
        margin: 2px 10px;
        color: #334155;
        text-decoration: none;
        transition: .15s;
    }

        .email-nav-item:hover {
            background: rgba(109,40,217,.06);
        }

        .email-nav-item.active {
            background: rgba(109,40,217,.10);
            border: 1px solid rgba(109,40,217,.18);
            color: #6d28d9;
        }

    .email-nav-left {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    .email-badge {
        min-width: 28px;
        height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        color: #fff;
    }

    .b-purple {
        background: #6d28d9;
    }

    .b-orange {
        background: #f59e0b;
    }

    .b-red {
        background: #ef4444;
    }

    .b-blue {
        background: #3b82f6;
    }

    .b-pink {
        background: #ec4899;
    }

    .b-gray {
        background: #64748b;
    }

    .btn-compose-mail {
        margin: 12px 16px 8px 16px;
        border-radius: 10px;
        background: #6d28d9;
        color: #fff;
        font-weight: 800;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        box-shadow: 0 10px 18px rgba(109,40,217,.18);
    }

        .btn-compose-mail:hover {
            color: #fff;
            filter: brightness(.98);
        }
</style>

<div class="sidebar-wrapper" data-simplebar="true">
    <div class="sidebar-header">
        <div>
            <img src="/vertical/assets/images/logo-icon.png" class="logo-icon-2" alt="" />
        </div>
        <div>
            <h4 class="logo-text">Email Project</h4>
        </div>
        <a href="javascript:;" class="toggle-btn ms-auto">
            <i class="bx bx-menu"></i>
        </a>
    </div>

    <!-- ✅ Soldaki “Yeni İleti” butonu (compose açacak) -->
    <a href="javascript:;" class="btn-compose-mail" id="btnOpenCompose">
        <i class="bx bx-plus"></i>
        Yeni İleti
    </a>

    <div class="email-navigation">

        <div class="email-nav-title">Mail Kutusu</div>

        <!-- ✅ Gmail mantığı: Gelen Kutusu rozetinde okunmamış sayısı -->
        <a href="/Message/Inbox" class="email-nav-item @(isActive("/message/inbox") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-inbox font-20'></i>
                <span>Gelen Kutusu</span>
            </span>
            <span class="email-badge b-purple">@inboxUnread</span>
        </a>

        <!-- ✅ Yıldızlı -->
        <a href="/Message/Starred"
           onclick="window.location.href='/Message/Starred'; return false;"
           class="email-nav-item @(isActive("/message/starred") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-star font-20' style="color:#f59e0b"></i>
                <span>Yıldızlı</span>
            </span>
            <span class="email-badge b-orange">@starCount</span>
        </a>

        <!-- ✅ Çöp Kutusu -->
        <a href="/Message/Trash"
           onclick="window.location.href='/Message/Trash'; return false;"
           class="email-nav-item @(isActive("/message/trash") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-trash font-20' style="color:#ef4444"></i>
                <span>Çöp Kutusu</span>
            </span>
            <span class="email-badge b-red">@trashCount</span>
        </a>

        <!-- ✅ Spam -->
        <a href="/Message/Spam"
           onclick="window.location.href='/Message/Spam'; return false;"
           class="email-nav-item @(isActive("/message/spam") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-error font-20' style="color:#ec4899"></i>
                <span>Spam</span>
            </span>
            <span class="email-badge b-pink">@spamCount</span>
        </a>

        <!-- ✅ Taslaklar -->
        <a href="/Message/Drafts" class="email-nav-item @(isActive("/message/drafts") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-file font-20'></i>
                <span>Taslaklar</span>
            </span>
            <span class="email-badge b-gray">@draftCount</span>
        </a>

        <!-- ✅ Gönderilenler -->
        <a href="/Message/Sent" class="email-nav-item @(isActive("/message/sent") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-send font-20'></i>
                <span>Gönderilenler</span>
            </span>
            <span class="email-badge b-blue">@sentTotal</span>
        </a>

        <div class="email-nav-title">Kategoriler</div>

        <!-- ✅ Kategori filtreleri -->
        <a href="/Message/Category?name=Eğitim" class="email-nav-item @(isActive("/message/category") && path.Contains("name=eğitim") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-book font-20'></i>
                <span>Eğitim</span>
            </span>
            <span class="email-badge b-purple">@catEdu</span>
        </a>

        <a href="/Message/Category?name=Proje" class="email-nav-item @(isActive("/message/category") && path.Contains("name=proje") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-briefcase font-20'></i>
                <span>Proje</span>
            </span>
            <span class="email-badge b-orange">@catProje</span>
        </a>

        <a href="/Message/Category?name=İş" class="email-nav-item @(isActive("/message/category") && path.Contains("name=iş") || path.Contains("name=iş") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-buildings font-20'></i>
                <span>İş</span>
            </span>
            <span class="email-badge b-blue">@catIs</span>
        </a>

        <a href="/Message/Category?name=Diğer" class="email-nav-item @(isActive("/message/category") && path.Contains("name=diğer") ? "active" : "")">
            <span class="email-nav-left">
                <i class='bx bxs-right-arrow-square font-20'></i>
                <span>Diğer</span>
            </span>
            <span class="email-badge b-gray">@catDiger</span>
        </a>

    </div>
</div>