@model Project2EmailNight.Entities.Message
@{
    Layout = "~/Views/Shared/_EmailLayout.cshtml";
}


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Yeni Mesaj</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <div class="container mt-5" style="max-width:900px;">
        <div class="card shadow-sm">
            <div class="card-body">

                <h4 class="mb-4">Yeni Mesaj</h4>

                <form method="post">

                    <div class="mb-3">
                        <label>Alıcı Email</label>
                        <input type="text" asp-for="ReceiverEmail" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Konu</label>
                        <input type="text" asp-for="Subject" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Mesaj</label>
                        <textarea id="editor" asp-for="MessageDetail" class="form-control" rows="10"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Message/Inbox" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">Gönder</button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <!-- ✅ CKEditor 5 CDN (API key istemez) -->
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'))
            .catch(error => console.error(error));
    </script>

</body>
</html>
