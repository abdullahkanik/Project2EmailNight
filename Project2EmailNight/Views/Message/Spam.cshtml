@model List<Project2EmailNight.Entities.Message>
@{
    Layout = "~/Views/Shared/_EmailLayout.cshtml";
    ViewData["Title"] = "Spam";
}

<div class="card radius-10">
    <div class="card-body">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h5 class="mb-0">Spam</h5>
                <small class="text-muted">@((Model?.Count) ?? 0) mesaj</small>
            </div>
        </div>

        <hr class="my-3" />

        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="position-relative">
                    <input id="inboxSearch" type="text" class="form-control ps-5" placeholder="Gönderici / konu ara...">
                    <span class="position-absolute top-50 translate-middle-y ms-3 text-muted">
                        <i class="bx bx-search"></i>
                    </span>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-8 text-md-end">
                <a href="/Message/Spam" class="btn btn-light" title="Yenile">
                    <i class="bx bx-refresh"></i>
                </a>
            </div>
        </div>

        <div class="table-responsive mt-3">
            <table class="table align-middle mb-0" id="inboxTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Gönderici</th>
                        <th>Konu</th>
                        <th style="width:180px">Tarih</th>
                        <th style="width:170px" class="text-end">İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            var rowClass = item.IsStatus ? "" : "table-warning";
                            <tr class="@rowClass">
                                <td class="fw-bold">@item.MessageId</td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-light rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bx bxs-user text-muted"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@item.SenderEmail</div>
                                            <small class="text-muted">to: @item.ReceiverEmail</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-semibold">@item.Subject</div>
                                    <small class="text-muted">Mesajı görüntülemek için aç</small>
                                </td>

                                <td class="text-muted">
                                    @item.SendDate.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td class="text-end">

                                    <!-- ⭐ Yıldız Toggle -->
                                    <form asp-controller="Message" asp-action="ToggleStar" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.MessageId" />
                                        <button type="submit"
                                                class="btn btn-sm @(item.IsStarred ? "btn-warning" : "btn-outline-warning")"
                                                title="Yıldızla">
                                            <i class="bx @(item.IsStarred ? "bxs-star" : "bx-star")"></i>
                                        </button>
                                    </form>

                                    <a class="btn btn-sm btn-outline-primary"
                                       href="/Message/MessageDetail/@item.MessageId"
                                       title="Aç">
                                        <i class="bx bx-show"></i>
                                    </a>

                                    <!-- 🗑️ Çöp -->
                                    <a class="btn btn-sm btn-outline-danger"
                                       href="/Message/DeleteMessage/@item.MessageId"
                                       title="Çöp"
                                       onclick="return confirm('Bu mesajı çöp kutusuna taşımak istiyor musun?');">
                                        <i class="bx bx-trash"></i>
                                    </a>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="text-center text-muted py-5">
                                    <i class="bx bx-error fs-1"></i>
                                    <div class="mt-2">Spam kutusu boş.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const input = document.getElementById("inboxSearch");
        const table = document.getElementById("inboxTable");

        if (input && table) {
            input.addEventListener("input", function () {
                const q = this.value.toLowerCase().trim();
                const rows = table.querySelectorAll("tbody tr");

                rows.forEach(r => {
                    const text = r.innerText.toLowerCase();
                    r.style.display = text.includes(q) ? "" : "none";
                });
            });
        }
    </script>
}